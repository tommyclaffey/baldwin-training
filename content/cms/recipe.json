   "steps": [
    {
     "title": "Season and sear",
     "detail": "Salt the ribs the day before. Sear hard on every side until deep brown.",
     "time": "Prep"
    },
    {
     "title": "Braise for 4 hours",
     "detail": "Cover with the braising liquid, lid on, in a 300°F oven until fork-tender.",
     "time": "4 hr"
    },
    {
     "title": "Rest and portion",
     "detail": "Cool in the liquid overnight. Portion cold so each piece holds its shape.",
     "time": "Overnight"
    },
    {
     "title": "Make the pan gravy",
     "detail": "Skim the fat, then reduce the braising liquid until it coats a spoon.",
     "time": "20 min"
    },
    {
     "title": "Fire to order",
     "detail": "Reheat a portion in its gravy. Wilt the spinach in the same pan.",
     "time": "8 min"
    },
    {
     "title": "Plate and pass",
     "detail": "Spinach first, rib on top, gravy over, carrot ribbon last. Wipe the rim.",
